# ==========================================
# Grade 8 Science Educational AI Platform
# Environment Configuration Template
# ==========================================

# 1. OpenAI API Credentials
# Required for generating dynamic assessments, vector embeddings (text-embedding-3-small), and AI tutor responses
OPENAI_API_KEY=your_openai_api_key_here

# 2. Relational Database (MySQL 8.0)
# Used for storing diagram metadata with Document AI descriptions and chat logs
# Pre-configured to match docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=grade8_science

# 3. Vector Database (Qdrant)
# Used for storing and retrieving Grade 8 Science textbook chunks
# Pre-configured to match docker-compose.yml
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=grade8_science_chunks

# 4. Application Server Configuration (FastAPI)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

